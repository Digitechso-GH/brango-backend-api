enum RecipientCustomerType {
  COMPANY
  INDIVIDUAL
}

enum AssignmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  OBSERVED
}

enum GeocodingStatus {
  PENDING
  VALIDATED
  FAILED
}

model Order {
  id                    String                @id @default(uuid())
  code                  String                @unique
  waybill               String?
  recipientCustomerType RecipientCustomerType @default(COMPANY)
  recipientDocument     String
  
  recipientName    String?
  recipientPhone   String?
  recipientEmail   String?
  warehouseContact String?

  rawAddress       String
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  geocodingStatus  GeocodingStatus    @default(PENDING)

  originBranchId String?
  originBranch   Branch?              @relation(fields: [originBranchId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignments       RouteAssignment[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([customerId])
  @@index([originBranchId])
}

model RouteAssignment {
  id            String           @id @default(uuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId      String
  driver        DriverProfile    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  date          DateTime
  sequenceIndex Int
  status        AssignmentStatus @default(PENDING)
  reasonText    String?

  previousAssignmentId String?
  previousAssignment   RouteAssignment?  @relation("AssignmentHistory", fields: [previousAssignmentId], references: [id])
  nextAssignments      RouteAssignment[] @relation("AssignmentHistory")

  originLatitude  Float?
  originLongitude Float?
  originAddress   String?

  events            OrderEvent[]
  evidences         Evidence[]
  locationSnapshots LocationSnapshot[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orderId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([date])
}

model Vehicle {
  id          String            @id @default(uuid())
  plate       String            @unique
  model       String?
  brand       String?
  assignments RouteAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OrderEvent {
  id                String          @id @default(uuid())
  routeAssignmentId String
  routeAssignment   RouteAssignment @relation(fields: [routeAssignmentId], references: [id], onDelete: Cascade)
  type              String
  actor             String
  metadata          Json?
  timestamp         DateTime        @default(now())
}

model LocationSnapshot {
  id                String           @id @default(uuid())
  driverId          String
  driver            DriverProfile    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  routeAssignmentId String?
  routeAssignment   RouteAssignment? @relation(fields: [routeAssignmentId], references: [id], onDelete: SetNull)

  latitude  Float
  longitude Float
  event     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([routeAssignmentId])
}

model Evidence {
  id                String          @id @default(uuid())
  routeAssignmentId String
  routeAssignment   RouteAssignment @relation(fields: [routeAssignmentId], references: [id], onDelete: Cascade)

  s3Url         String
  fileSizeKb    Int?
  signatureText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeAssignmentId])
}
