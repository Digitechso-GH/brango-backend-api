################################################################################
# .env.example (PLANTILLA PARA EL SERVIDOR DE PRODUCCIÓN)
#
# ⚠️ IMPORTANTE: Este archivo es solo una PLANTILLA / GUÍA.
# El código NO lee este archivo.
# NO DEBES poner contraseñas ni llaves reales aquí (por extrema seguridad).
#
# ¿Para qué sirve?
# Cuando vayas a desplegar el backend en un servidor real (VPS, DigitalOcean, etc.),
# usa esta plantilla para saber exactamente qué variables de entorno vas a tener 
# que crear y pegar a mano en el panel de control de tu servidor.
#
# ¿Por qué algunas variables tienen valores reales (como CORS_ORIGINS)?
# Porque son valores públicos o configuraciones por defecto que no representan
# ningún riesgo de seguridad (no son contraseñas). Sirven de ejemplo para 
# que sepas el formato exacto que espera el código. Las credenciales sí 
# deben estar vacías o con textos falsos.
################################################################################

# --- SERVIDOR Y CONFIGURACIÓN GENERAL ---
NODE_ENV=production
# Puerto interno para Docker (usualmente 3000)
PORT=3000
# El frontend web y/o app móvil que se conectarán
CORS_ORIGINS=https://brango.syncrodg.com,http://brango.syncrodg.com

# --- BASE DE DATOS (POSTGRESQL) ---
DATABASE_URL=postgresql://brango_user:TU_PASSWORD_AQUI@brango-database-prod:5432/bran_go_db?schema=public

# --- SEGURIDAD Y AUTENTICACIÓN (JWT) ---
JWT_SECRET=PON_UNA_CLAVE_SUPER_SECRETA_Y_LARGA_AQUI
JWT_EXPIRES_IN=7d

# --- SERVICIO DE ALMACENAMIENTO (CLOUDFLARE R2) ---
STORAGE_ENDPOINT=https://<TU-ACCOUNT-ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=tu_r2_access_key
STORAGE_SECRET_KEY=tu_r2_secret_key
STORAGE_BUCKET=tu_bucket
STORAGE_PUBLIC_URL=https://tu-url-r2.dev

# --- NOTIFICACIONES (META WHATSAPP API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
