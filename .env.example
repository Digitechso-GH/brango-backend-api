# --- SERVIDOR Y CONFIGURACIÓN GENERAL ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# --- BASE DE DATOS (POSTGRESQL) ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/bran_go_db?schema=public

# --- SEGURIDAD Y AUTENTICACIÓN (JWT) ---
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# --- TELEMETRÍA Y WEBSOCKETS ---
WS_PORT=3002

# --- SERVICIO DE ALMACENAMIENTO (AWS S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=

# --- NOTIFICACIONES (META WHATSAPP API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
